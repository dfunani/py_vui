    "customCode": "expression = ''\n\n\ndef _press(key):\n    global expression\n    if key == '=':\n        try:\n            expression = str(eval(expression, {'__builtins__': {}}))\n        except Exception:\n            expression = 'Error'\n    elif key == 'C':\n        expression = ''\n    else:\n        expression += key\n    print(expression)",
